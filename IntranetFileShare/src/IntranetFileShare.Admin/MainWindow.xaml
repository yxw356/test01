<Window x:Class="IntranetFileShare.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IntranetFileShare.Admin"
        Title="内网文件共享 - 管理端"
        Height="680" Width="1024"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="服务器" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="200" Text="{Binding ServerUrl}" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBool}}"/>
            <TextBlock Text="用户名" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox Width="100" Text="{Binding Username}"/>
            <TextBlock Text="密码" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <PasswordBox x:Name="PasswordBox" Width="120" Margin="0,0,8,0"/>
            <Button Content="登录" Command="{Binding LoginCommand}" Padding="12,4"/>
            <Button Content="刷新全部" Command="{Binding LoadAllCommand}" Padding="12,4" Margin="8,0,0,0"
                    IsEnabled="{Binding IsLoggedIn}"/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" IsEnabled="{Binding IsLoggedIn}">
            <!-- Users -->
            <TabItem Header="用户管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="100" Text="{Binding NewUsername}" ToolTip="用户名"/>
                        <TextBox Width="100" Text="{Binding NewPassword}" Margin="4,0" ToolTip="密码"/>
                        <TextBox Width="100" Text="{Binding NewDisplayName}" Margin="0,0,4,0" ToolTip="显示名"/>
                        <ComboBox Width="100" ItemsSource="{Binding UserRoles}" SelectedItem="{Binding NewRole}" Margin="0,0,4,0"/>
                        <Button Content="创建用户" Command="{Binding CreateUserCommand}" Padding="8,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="120"/>
                            <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="100"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Padding="4,2"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Groups -->
            <TabItem Header="组管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="200" Text="{Binding NewGroupName}" ToolTip="组名"/>
                        <Button Content="创建组" Command="{Binding CreateGroupCommand}" Padding="8,4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Shares -->
            <TabItem Header="共享管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Agent 列表" FontWeight="Bold"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Agents}" AutoGenerateColumns="False" IsReadOnly="True" Height="120" Margin="0,4,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="机器名" Binding="{Binding MachineName}" Width="*"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Width="80" Text="{Binding NewShareAgentId}" ToolTip="Agent ID"/>
                            <TextBox Width="120" Text="{Binding NewShareName}" Margin="4,0" ToolTip="逻辑名"/>
                            <TextBox Width="200" Text="{Binding NewSharePath}" Margin="0,0,4,0" ToolTip="本地路径"/>
                            <Button Content="创建共享" Command="{Binding CreateShareCommand}" Padding="8,4"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Shares}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding LogicalName}" Width="120"/>
                                <DataGridTextColumn Header="路径" Binding="{Binding LocalPath}" Width="*"/>
                                <DataGridTextColumn Header="机器" Binding="{Binding MachineName}" Width="120"/>
                                <DataGridTextColumn Header="Agent状态" Binding="{Binding AgentStatus}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ACL -->
            <TabItem Header="ACL 配置">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ComboBox ItemsSource="{Binding Shares}" SelectedItem="{Binding SelectedShare}"
                              DisplayMemberPath="LogicalName" Width="300" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                        <ComboBox Width="80" ItemsSource="{Binding PrincipalTypes}" SelectedItem="{Binding AclPrincipalType}"/>
                        <TextBox Width="100" Text="{Binding AclPrincipalId}" Margin="4,0" ToolTip="主体ID"/>
                        <ComboBox Width="80" ItemsSource="{Binding AclActions}" SelectedItem="{Binding AclAction}" Margin="0,0,4,0"/>
                        <ComboBox Width="80" ItemsSource="{Binding AclEffects}" SelectedItem="{Binding AclEffect}" Margin="0,0,4,0"/>
                        <Button Content="添加 ACL" Command="{Binding AddAclCommand}" Padding="8,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding AclEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="主体类型" Binding="{Binding PrincipalType}" Width="90"/>
                            <DataGridTextColumn Header="主体ID" Binding="{Binding PrincipalId}" Width="100"/>
                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="80"/>
                            <DataGridTextColumn Header="效果" Binding="{Binding Effect}" Width="80"/>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Padding="4,2"
                                                Command="{Binding DataContext.DeleteAclCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Audit -->
            <TabItem Header="审计日志">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="刷新" Command="{Binding LoadAuditCommand}" Padding="8,4" HorizontalAlignment="Left"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="160"/>
                            <DataGridTextColumn Header="用户" Binding="{Binding Username}" Width="100"/>
                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="100"/>
                            <DataGridTextColumn Header="ShareId" Binding="{Binding ShareId}" Width="70"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray"/>
    </Grid>
</Window>
